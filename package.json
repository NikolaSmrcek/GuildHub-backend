{
  "name": "guildhub-backend",
  "version": "0.1.0",
  "description": "GuildHub backend (NestJS + TypeScript + Fastify)",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "seed": "npx ts-node-dev src/seed/seed.ts",
    "lint": "npx eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "npx eslint --config eslint.config.mjs \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  }
}
